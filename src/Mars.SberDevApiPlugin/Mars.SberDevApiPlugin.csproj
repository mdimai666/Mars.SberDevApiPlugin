<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!--Author-->
        <PackageId>mdimai666.Mars.SberDevApiPlugin</PackageId>
        <Version>0.2.3</Version>
        <!--Public-->
        <Authors>mdimai666</Authors>
        <Company>mdimai666</Company>
        <Product>Mars.SberDevApiPlugin</Product>
        <PackageTags>Mars;Sber devices</PackageTags>
        <Description>
            Provide sber devices functions for Mars
            - Speech API
        </Description>

        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
        <PackageReference Include="mdimai666.Mars.Plugin.Sdk" Version="0.8.4-alpha.57">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="mdimai666.Mars.Plugin.Kit.Host" Version="0.8.4-alpha.57" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GigaChatAPI\GigaChatAPI.csproj" />
        <ProjectReference Include="..\Mars.SberDevApiPlugin.Front\Mars.SberDevApiPlugin.Front.csproj" />
        <ProjectReference Include="..\SaluteSpeechAPI\SaluteSpeechAPI.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.local.json">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Паковка — таргетами пакета mdimai666.Mars.Plugin.Sdk (без явных таргетов здесь):
         publish Release -> отсечение сборок Марса + манифест + дескриптор + zip;
         dotnet msbuild -t:MarsPluginPackNuget -c Release -> nupkg;
         Debug-сборка -> дев-манифест. -->

</Project>
